# --- Go ---
server/bin/
*.test
*.out
coverage/

# --- Generated protobuf code (never committed: `make proto` locally; CI runs
# --- buf generate before every Go compile — ci.yml backend/migrations jobs) ---
server/internal/proto/gen/
clients/packages/proto-types/src/gen/

# --- Node / clients ---
node_modules/
dist/
build/
.expo/
*.tsbuildinfo

# --- Env & secrets (SOPS-encrypted files ARE committed; raw secrets never) ---
.env
.env.*
!.env.example
*.agekey
*.pem
*.p8

# --- Helm (vendored subcharts + lock are regenerated by `helm dependency
# --- update`; deps are local file:// — CI regenerates in the deploy job) ---
deploy/helm/*/charts/
deploy/helm/*/Chart.lock

# --- Terraform ---
*.tfstate
*.tfstate.*
.terraform/
.terraform.lock.hcl

# --- IDE / OS ---
.DS_Store
.idea/
.vscode/
*.swp

# --- Local dev data ---
deploy/compose/data/
